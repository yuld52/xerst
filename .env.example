# Frontend values are embedded into the client build. The publishable key is public;
# never put a Supabase secret/service-role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side counterparts used by the globally attached Supabase auth middleware.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Leave VITE_API_URL unset when using the same-domain Vercel /api rewrite.
