{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "tanstack-start"
    },
    "original-backend": {
      "root": "reference/original-backend",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "original-backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/automation/rules/run",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/automation/reports/run",
      "schedule": "0 * * * *"
    }
  ]
}
