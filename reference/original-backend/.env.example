# Use the Supabase transaction pooler URL (or another reachable PostgreSQL URL).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Generate a unique random secret; changing it invalidates existing login tokens.
SECRET_KEY=replace-with-a-unique-random-secret

META_GRAPH_API_VERSION=v25.0
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN/api/meta/callback

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Generate a fresh VAPID key pair before enabling web push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=admin@example.com

# Supabase client configuration, if the Supabase client features are used.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
